---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import SelectedWork from "../components/SelectedWork.astro";
import Credibility from "../components/Credibility.astro";
import AboutIntro from "../components/AboutIntro.astro";
import BlogPreview from "../components/BlogPreview.astro";
import ClosingCta from "../components/ClosingCta.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../lib/site-config";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: siteConfig.name,
  slogan: siteConfig.tagline,
  description:
    "Marketing solutions and commercial visual media partner for small and medium-sized businesses across the Midwest — marketing consultation, Google Business Profile optimization, AI search visibility, digital advertising, and website design, plus branding, commercial, real estate, and aerial photography and video.",
  image: new URL("/og-image.jpg", Astro.site).toString(),
  url: Astro.site?.toString(),
  telephone: siteConfig.contact.phone ?? undefined,
  email: siteConfig.contact.email ?? undefined,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Woodbine",
    addressRegion: "IA",
    addressCountry: "US",
  },
  areaServed: `${siteConfig.marketingArea}, with on-location photography and aerial coverage across ${siteConfig.serviceArea}`,
  sameAs: [siteConfig.contact.facebookUrl].filter(Boolean),
};
---

<BaseLayout
  title="LENZ — Marketing Solutions & Commercial Visual Media"
  description="LENZ is an Iowa-based small business marketing partner for companies across the Midwest — marketing consultation, Google Business Profile optimization, local and AI search visibility, digital advertising, and website design, plus commercial visual media: branding, commercial, real estate, and aerial photography and video. Visual storytelling from every angle."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Header />
  <main id="main-content">
    <Hero />
    <Services />
    <SelectedWork />
    <Credibility />
    <AboutIntro />
    <BlogPreview />
    <ClosingCta />
  </main>
  <Footer />
</BaseLayout>
