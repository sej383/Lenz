---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { siteConfig } from "../../lib/site-config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// timeZone: "UTC" is deliberate — see src/pages/blog/index.astro for why.
const formatDate = (date: Date) => date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

// Category-aware closing CTA. Real Estate posts (none exist yet, but the
// category already supports them) point at the external booking flow like
// every other Real Estate CTA on the site; everything else points at the
// contact form. Add more category overrides here if a future category
// needs its own destination — no schema field needed for this.
const ctaByCategory: Record<string, { label: string; href: string; external: boolean }> = {
  "Real Estate": { label: "Book Real Estate", href: siteConfig.bookRealEstateUrl, external: true },
};
const cta = ctaByCategory[post.data.category] ?? { label: "Start a Project", href: "/contact/", external: false };

const description = post.data.metaDescription ?? post.data.excerpt;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  author: { "@type": "Person", name: post.data.author },
  ...(post.data.publishDate && { datePublished: post.data.publishDate.toISOString() }),
  dateModified: (post.data.updatedDate ?? post.data.publishDate)?.toISOString(),
};
---

<BaseLayout title={`${post.data.title} — LENZ`} description={description} type="article">
  <Header />
  <main id="main-content">
    <article class="blog-article">
      <div class="section section--light blog-article__intro">
        <div class="container blog-article__head">
          <p class="eyebrow">{post.data.category}</p>
          <h1>{post.data.title}</h1>
          <p class="blog-article__byline">
            {post.data.author}
            {post.data.publishDate && (
              <>
                {" "}
                · <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
              </>
            )}
            {post.data.updatedDate && (
              <span class="blog-article__updated">
                {" "}
                · Updated <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time>
              </span>
            )}
          </p>
        </div>
      </div>

      <div class="container blog-article__media">
        <Image
          src={post.data.image}
          alt={post.data.imageAlt}
          widths={[500, 800, 1200, 1600]}
          width={1600}
          sizes="(min-width: 62.5em) 1100px, 100vw"
          loading="eager"
        />
      </div>

      <div class="section section--light section--sand blog-article__body-section">
        <div class="container blog-article__body">
          <Content />
        </div>

        <div class="container blog-article__closing">
          <p>
            {cta.external ? (
              <>
                Booking a listing?{" "}
                <a href={cta.href} target="_blank" rel="noopener noreferrer">
                  {cta.label}
                  <span class="visually-hidden">(opens the online booking site in a new tab)</span>
                </a>
              </>
            ) : (
              <>
                Have a project like this in mind? <a href={cta.href}>{cta.label}</a>
              </>
            )}
          </p>
        </div>
      </div>
    </article>
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .blog-article__intro {
    padding-bottom: 0;
  }

  .blog-article__head h1 {
    font-size: var(--step-3);
    font-weight: 500;
    margin-top: 0.35em;
    max-width: 32ch;
    color: var(--color-charcoal);
  }

  .blog-article__byline {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .blog-article__updated {
    color: var(--color-muted);
  }

  .blog-article__media {
    margin-top: var(--space-md);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-charcoal-soft);
  }

  .blog-article__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-article__body {
    max-width: 42rem;
    margin-inline: auto;
    color: var(--color-charcoal);
    font-size: var(--step-0);
    line-height: 1.7;
  }

  .blog-article__body :global(h2) {
    font-size: var(--step-2);
    font-weight: 500;
    margin-top: 1.8em;
  }

  .blog-article__body :global(h2:first-child) {
    margin-top: 0;
  }

  .blog-article__body :global(h3) {
    font-size: var(--step-1);
    font-weight: 600;
    margin-top: 1.5em;
  }

  .blog-article__body :global(p) {
    margin-top: 1em;
  }

  .blog-article__body :global(ul) {
    margin-top: 1em;
    padding-left: 1.4em;
    display: flex;
    flex-direction: column;
    gap: 0.4em;
  }

  .blog-article__body :global(li) {
    list-style: disc;
  }

  .blog-article__body :global(strong) {
    font-weight: 600;
    color: var(--color-charcoal);
  }

  .blog-article__body :global(a) {
    color: var(--color-bronze);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .blog-article__closing {
    max-width: 42rem;
    margin: var(--space-lg) auto 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-hairline-on-cream);
    font-size: var(--step-0);
    color: var(--color-charcoal);
  }

  .blog-article__closing a {
    color: var(--color-bronze);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (min-width: 50em) {
    .blog-article__media {
      aspect-ratio: 21 / 9;
    }
  }
</style>
