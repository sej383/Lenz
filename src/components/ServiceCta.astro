---
// Single-path closing CTA, reused across service pages (Commercial now;
// Branding, Real Estate, Aerial later). The homepage's dual-path
// ClosingCta.astro is a different, homepage-specific component — service
// pages only need the one relevant action.
interface Props {
  eyebrow?: string;
  heading: string;
  copy: string;
  ctaLabel?: string;
  ctaHref?: string;
  external?: boolean;
}

const {
  eyebrow = "Get Started",
  heading,
  copy,
  ctaLabel = "Start a Project",
  ctaHref = "/contact/",
  external = false,
} = Astro.props;
---

<section class="section section--dark surface-leather service-cta">
  <div class="container service-cta__inner">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{heading}</h2>
    <p class="service-cta__copy">{copy}</p>
    {
      external ? (
        <a class="btn btn-primary" href={ctaHref} target="_blank" rel="noopener noreferrer">
          {ctaLabel}
          <span class="visually-hidden">(opens the HDPhotoHub booking site in a new tab)</span>
        </a>
      ) : (
        <a class="btn btn-primary" href={ctaHref}>
          {ctaLabel}
        </a>
      )
    }
    {Astro.slots.has("note") && (
      <p class="service-cta__note"><slot name="note" /></p>
    )}
  </div>
</section>

<style>
  .service-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    max-width: 36rem;
  }

  .service-cta__inner h2 {
    margin-top: 0.2em;
  }

  .service-cta__copy {
    color: var(--color-muted-on-dark);
  }

  .service-cta__inner .btn {
    margin-top: var(--space-xs);
  }

  .service-cta__note {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--color-muted-on-dark);
  }

  .service-cta__note :global(a) {
    color: var(--color-gold-soft);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
