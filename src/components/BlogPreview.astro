---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).slice(0, 3);
---

<section class="section section--light blog-preview">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal="eyebrow">Insights</p>
      <h2 data-reveal="heading">From the Blog</h2>
      <p data-reveal="body">Notes on real estate, commercial, branding, and aerial photography.</p>
    </div>

    <div class="blog-preview__grid">
      {
        posts.map((post) => (
          <article class="blog-card">
            <div class="blog-card__media">
              <Image
                src={post.data.image}
                alt={post.data.imageAlt}
                widths={[400, 650, 900]}
                width={900}
                sizes="(min-width: 62.5em) 30vw, 90vw"
              />
              {post.data.isPlaceholder && <span class="blog-card__sample">Sample Post</span>}
            </div>
            <span class="eyebrow">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
          </article>
        ))
      }
    </div>

    <div class="section-foot">
      <a class="btn btn-secondary" href="/blog/">View the Blog</a>
    </div>
  </div>
</section>

<style>
  .blog-preview__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5em;
  }

  .blog-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: var(--space-2xs);
  }

  .blog-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-card__sample {
    position: absolute;
    top: var(--space-2xs);
    right: var(--space-2xs);
    background: var(--color-charcoal);
    color: var(--color-gold-soft);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3em 0.6em;
  }

  .blog-card h3 {
    font-size: var(--step-1);
    font-weight: 500;
  }

  .blog-card p {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  @media (min-width: 50em) {
    .blog-preview__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-sm);
    }
  }
</style>
