---
// Three alternating rows, same proven pattern as Commercial and Branding.
import { Image } from "astro:assets";
import interiorPhoto from "../../assets/photos/svc-realestate-elkhorn-kitchen.jpg";
import exteriorPhoto from "../../assets/photos/hero-real-estate.jpg";
import aerialPhoto from "../../assets/photos/svc-realestate-victorian-aerial.jpg";

const rows = [
  {
    key: "interiors",
    label: "Interiors & Details",
    copy: "Strong, accurate interior photography that shows layout, scale, finishes, and the character of the property.",
    image: interiorPhoto,
    alt: "A modern kitchen with a waterfall marble island and open wood shelving",
  },
  {
    key: "exteriors",
    label: "Exteriors & Twilight",
    copy: "Exterior coverage from daytime through twilight, including properties with pools, acreage, waterfront, and distinctive outdoor features.",
    image: exteriorPhoto,
    alt: "Twilight view of a stone and shingle pool house with a lit backyard pool",
  },
  {
    key: "aerial",
    label: "Aerial & Property Perspective",
    copy: "FAA Part 107 licensed and insured aerial coverage for homes, acreages, land, and properties where location and context matter.",
    image: aerialPhoto,
    alt: "Aerial view of a two-story brick home with a wraparound porch",
  },
];
---

<section class="section section--dark surface-leather-tall capabilities">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">What We Cover</p>
      <h2>Three Areas of Real Estate Work</h2>
    </div>

    <div class="capabilities__rows">
      {
        rows.map((row, i) => (
          <article class:list={["capability-row", { "capability-row--reverse": i % 2 === 1 }]}>
            <div class="capability-row__media">
              <Image
                src={row.image}
                alt={row.alt}
                widths={[500, 800, 1100]}
                width={1100}
                sizes="(min-width: 55em) 50vw, 100vw"
              />
            </div>
            <div class="capability-row__body">
              <span class="eyebrow">{row.label}</span>
              <p>{row.copy}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .capabilities__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .capability-row {
    display: grid;
    gap: var(--space-sm);
    align-items: start;
  }

  .capability-row__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid rgba(224, 176, 104, 0.16);
  }

  .capability-row__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .capability-row__body {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    max-width: 30rem;
    padding-top: 0.35em;
  }

  .capability-row__body .eyebrow {
    color: var(--color-gold-soft);
  }

  .capability-row__body p {
    color: var(--color-muted-on-dark);
  }

  @media (min-width: 55em) {
    .capability-row {
      grid-template-columns: 1.3fr 1fr;
    }

    .capability-row--reverse {
      grid-template-columns: 1fr 1.3fr;
    }

    .capability-row--reverse .capability-row__media {
      order: 2;
    }

    .capability-row--reverse .capability-row__body {
      order: 1;
      justify-self: end;
    }
  }
</style>
