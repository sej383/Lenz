---
// Single-image, full-bleed hero — same proven structure as Commercial and
// Branding. The lakefront aerial (40 Pickard Lane) needs a different crop
// at each size: the mobile hero band is tall/narrow and shows the water
// and dock at plain center, but the wide desktop band needs the visible
// window pushed down (see .real-estate-hero__image object-position below)
// or the water disappears off the bottom edge.
import { Image } from "astro:assets";
import { siteConfig } from "../../lib/site-config";
import pickardPhoto from "../../assets/photos/work-realestate-pickard-exterior.jpg";
---

<section class="real-estate-hero texture-charcoal">
  <Image
    src={pickardPhoto}
    alt="Aerial view of a blue lakefront home with a private dock"
    widths={[700, 1100, 1500, 1900, 2400]}
    width={2400}
    sizes="100vw"
    loading="eager"
    class="real-estate-hero__image"
  />

  <div class="real-estate-hero__scrim" aria-hidden="true"></div>

  <div class="container real-estate-hero__content">
    <p class="eyebrow">Services · Real Estate</p>
    <h1>Real Estate Media Built to Make Listings Stand Out</h1>
    <p class="real-estate-hero__copy">
      Professional listing photography plus aerial, video, floor plans, tours, and other
      marketing-ready media — ordered directly and delivered fast.
    </p>
    <a class="btn btn-primary" href={siteConfig.bookRealEstateUrl} target="_blank" rel="noopener noreferrer">
      Book Real Estate
      <span class="visually-hidden">(opens the HDPhotoHub booking site in a new tab)</span>
    </a>
  </div>
</section>

<style>
  .real-estate-hero {
    position: relative;
    min-height: clamp(26rem, 80vh, 42rem);
    display: flex;
    align-items: flex-end;
    background: var(--surface-dark);
    overflow: hidden;
  }

  .real-estate-hero :global(.real-estate-hero__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .real-estate-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(15, 13, 11, 0.92) 0%, rgba(15, 13, 11, 0.55) 40%, rgba(15, 13, 11, 0.1) 75%);
  }

  .real-estate-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: var(--space-xl) var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    color: var(--color-offwhite);
  }

  .real-estate-hero__content h1 {
    font-size: var(--step-4);
    font-weight: 500;
    max-width: 26ch;
    margin-top: 0.2em;
  }

  .real-estate-hero__copy {
    max-width: 34rem;
    color: var(--color-muted-on-dark);
  }

  .real-estate-hero__content .btn {
    margin-top: var(--space-xs);
  }

  @media (min-width: 62.5em) {
    .real-estate-hero {
      min-height: clamp(30rem, 90vh, 46rem);
    }

    /* The wide desktop band crops off the water at plain center — pushing
       the visible window down keeps the house, deck, water, and dock all
       in frame. Mobile's taller/narrower band doesn't need this. */
    .real-estate-hero :global(.real-estate-hero__image) {
      object-position: center 70%;
    }
  }
</style>
