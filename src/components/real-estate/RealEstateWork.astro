---
// All seven curated images are landscape, so unlike Branding's gallery
// there's no orientation mismatch to solve — instead the differentiation
// from Commercial's uniform grid is a single full-width feature image
// (the twilight shot) followed by a clean 3x2 grid for the rest, reading
// as "here's our strongest work" before "here's the range."
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const entries = await getCollection("work", ({ data }) => data.featuredOnServicePages.includes("real-estate"));
const sorted = entries.sort((a, b) => a.data.featuredOrder - b.data.featuredOrder).map((entry) => entry.data);

const feature = sorted.find((item) => item.title === "3865 Martha St, Twilight");
const rest = sorted.filter((item) => item.title !== "3865 Martha St, Twilight");
---

<section class="section section--light real-estate-work">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Selected Real Estate Work</p>
      <h2>A Closer Look</h2>
    </div>

    <div class="real-estate-work__layout">
      {
        feature && (
          <figure class="real-estate-work__feature">
            <Image
              src={feature.image}
              alt={feature.imageAlt}
              widths={[700, 1100, 1500]}
              width={1500}
              sizes="100vw"
              style={`object-position: ${feature.objectPosition};`}
            />
          </figure>
        )
      }

      <div class="real-estate-work__grid">
        {
          rest.map((item) => (
            <figure class="real-estate-work__tile">
              <Image
                src={item.image}
                alt={item.imageAlt}
                widths={[400, 700, 1000]}
                width={1000}
                sizes="(min-width: 55em) 33vw, (min-width: 40em) 50vw, 100vw"
                style={`object-position: ${item.objectPosition};`}
              />
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .real-estate-work__layout {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .real-estate-work__feature {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-charcoal-soft);
  }

  .real-estate-work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3px;
  }

  .real-estate-work__tile {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-charcoal-soft);
  }

  .real-estate-work__feature :global(img),
  .real-estate-work__tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-editorial);
  }

  .real-estate-work__feature:hover :global(img),
  .real-estate-work__tile:hover :global(img) {
    transform: scale(1.03);
  }

  @media (min-width: 40em) {
    .real-estate-work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 55em) {
    .real-estate-work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
