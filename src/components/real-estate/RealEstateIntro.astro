---
import { siteConfig } from "../../lib/site-config";
---

<section class="section section--light real-estate-intro">
  <div class="container">
    <p class="eyebrow">Listing Media Partner</p>
    <p class="real-estate-intro__statement">
      LENZ works as a listing-media partner for real estate agents, brokerages, builders, and
      property professionals throughout {siteConfig.serviceArea} — with dependable turnaround
      and consistent quality, order after order.
    </p>
  </div>
</section>

<style>
  .real-estate-intro__statement {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.35;
    max-width: 46rem;
    margin-top: 0.5em;
    color: var(--color-charcoal);
  }
</style>
