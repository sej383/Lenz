---
// Same light-section positioning pattern as Commercial's PositioningIntro,
// with one addition: a row of concrete use-cases. Branding buyers are
// judging whether the imagery is actually usable across their channels, so
// naming the channels does real work here rather than being decoration.
import { siteConfig } from "../../lib/site-config";

const useCases = ["Websites", "Social Media", "Advertising", "Print", "Email Marketing", "Business Collateral"];
---

<section class="section section--light branding-intro">
  <div class="container">
    <p class="eyebrow">Who We Work With</p>
    <p class="branding-intro__statement">
      LENZ creates custom imagery for businesses, service providers, products, and brands
      throughout {siteConfig.serviceArea}.
    </p>
    <ul class="branding-intro__uses">
      {useCases.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .branding-intro__statement {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.35;
    max-width: 46rem;
    margin-top: 0.5em;
    color: var(--color-charcoal);
  }

  .branding-intro__uses {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.5em;
    margin-top: var(--space-sm);
    list-style: none;
    padding: 0;
  }

  .branding-intro__uses li {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .branding-intro__uses li:not(:last-child)::after {
    content: "·";
    display: inline-block;
    margin-inline: 0.75em;
    color: var(--color-gold);
  }
</style>
