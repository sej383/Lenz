---
// A wide feature image (matching the capability panels' 2:1 cinematic
// aspect for visual consistency) followed by a clean grid — six images
// chosen deliberately for range (construction, development, land, ag,
// landmark, commercial-scale) rather than six similar property shots.
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const entries = await getCollection("work", ({ data }) => data.featuredOnServicePages.includes("aerial"));
const sorted = entries.sort((a, b) => a.data.featuredOrder - b.data.featuredOrder).map((entry) => entry.data);

const feature = sorted.find((item) => item.title === "New Construction, Straight Down");
const rest = sorted.filter((item) => item.title !== "New Construction, Straight Down");
---

<section class="section section--light section--sand aerial-work">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Selected Aerial Work</p>
      <h2>A Closer Look</h2>
    </div>

    <div class="aerial-work__layout">
      {
        feature && (
          <figure class="aerial-work__feature">
            <Image
              src={feature.image}
              alt={feature.imageAlt}
              widths={[700, 1100, 1500, 1900]}
              width={1900}
              sizes="100vw"
              style={`object-position: ${feature.objectPosition};`}
            />
          </figure>
        )
      }

      <div class="aerial-work__grid">
        {
          rest.map((item) => (
            <figure class="aerial-work__tile">
              <Image
                src={item.image}
                alt={item.imageAlt}
                widths={[400, 700, 1000]}
                width={1000}
                sizes="(min-width: 55em) 33vw, (min-width: 40em) 50vw, 100vw"
                style={`object-position: ${item.objectPosition};`}
              />
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .aerial-work__layout {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .aerial-work__feature {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 2 / 1;
    background: var(--color-charcoal-soft);
  }

  .aerial-work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3px;
  }

  .aerial-work__tile {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-charcoal-soft);
  }

  .aerial-work__feature :global(img),
  .aerial-work__tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-editorial);
  }

  .aerial-work__feature:hover :global(img),
  .aerial-work__tile:hover :global(img) {
    transform: scale(1.03);
  }

  @media (min-width: 40em) {
    .aerial-work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 55em) {
    .aerial-work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
