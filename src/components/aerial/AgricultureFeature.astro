---
// Featured portfolio piece, not a seasonal banner — a specific, strong
// example of the aerial + commercial capability already described above,
// for a niche (agriculture/rural business) the rest of the page doesn't
// call out by name. Deliberately click-to-play: the source video is ~25MB,
// so nothing beyond the poster photo (a single ~100KB JPEG) loads until a
// visitor actually presses play. No autoplay, no preloaded video data.
---

<section class="section section--light agriculture">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Agriculture &amp; Rural Business</p>
      <h2>Agriculture, From a Different Perspective</h2>
      <p>
        The work, the land, the equipment, the people behind it — captured from every angle. LENZ
        creates professional photography and aerial video for farms, agribusinesses and rural
        brands throughout the Midwest.
      </p>
    </div>

    <div class="agriculture__player" data-video-player>
      <img
        src="/videos/harvest-poster.jpg"
        alt="Aerial view of a combine harvester working a field at golden hour, dust trailing behind it"
        class="agriculture__frame"
        data-poster
      />
      <video class="agriculture__frame agriculture__video" data-video preload="none" playsinline hidden
      ></video>
      <span class="agriculture__tag">Featured Film</span>
      <button type="button" class="agriculture__play" data-play-button aria-label="Play video: Harvest, From a Different View">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor" />
        </svg>
      </button>
    </div>

    <div class="section-foot">
      <a class="btn btn-primary" href="/contact/">Tell Your Story</a>
    </div>
  </div>
</section>

<script>
  const wrap = document.querySelector<HTMLElement>("[data-video-player]");
  const playButton = wrap?.querySelector<HTMLButtonElement>("[data-play-button]");
  const poster = wrap?.querySelector<HTMLImageElement>("[data-poster]");
  const tag = wrap?.querySelector<HTMLElement>(".agriculture__tag");
  const video = wrap?.querySelector<HTMLVideoElement>("[data-video]");

  if (wrap && playButton && poster && video) {
    playButton.addEventListener(
      "click",
      () => {
        const source = document.createElement("source");
        source.src = "/videos/harvest-aerial.mp4";
        source.type = "video/mp4";
        video.appendChild(source);
        video.setAttribute("controls", "");
        video.hidden = false;
        poster.hidden = true;
        playButton.hidden = true;
        if (tag) tag.hidden = true;
        video.load();
        video.play();
      },
      { once: true }
    );
  }
</script>

<style>
  .agriculture__player {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid rgba(224, 176, 104, 0.16);
    background: var(--color-charcoal);
  }

  .agriculture__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .agriculture__tag {
    position: absolute;
    top: var(--space-2xs);
    left: var(--space-2xs);
    padding: 0.35em 0.7em;
    background: rgba(21, 17, 13, 0.55);
    backdrop-filter: blur(2px);
    color: var(--color-gold-soft);
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .agriculture__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    border: 1px solid rgba(238, 230, 216, 0.5);
    background: rgba(21, 17, 13, 0.55);
    backdrop-filter: blur(2px);
    color: var(--color-offwhite);
    transition: transform var(--duration-base) var(--ease-editorial),
      background var(--duration-base) var(--ease-editorial);
  }

  .agriculture__play svg {
    transform: translateX(2px);
  }

  .agriculture__play:hover,
  .agriculture__play:focus-visible {
    background: var(--color-gold);
    color: var(--color-charcoal);
    transform: translate(-50%, -50%) scale(1.06);
  }

  .agriculture__play:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }

  @media (min-width: 40em) {
    .agriculture__play {
      width: 5.5rem;
      height: 5.5rem;
    }
  }
</style>
