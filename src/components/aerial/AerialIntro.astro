---
import { siteConfig } from "../../lib/site-config";
---

<section class="section section--light aerial-intro">
  <div class="container">
    <p class="eyebrow">Perspective, Used Intentionally</p>
    <p class="aerial-intro__statement">
      LENZ provides professional aerial photography and video throughout {siteConfig.serviceArea},
      with travel available for commercial and specialty projects. The value isn't simply
      getting a drone in the air — it's using that perspective intentionally to show scale,
      progress, location, and context.
    </p>
  </div>
</section>

<style>
  .aerial-intro__statement {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.35;
    max-width: 48rem;
    margin-top: 0.5em;
    color: var(--color-charcoal);
  }
</style>
