---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const entries = await getCollection("work", ({ data }) => data.featuredOnServicePages.includes("commercial"));
const items = entries.sort((a, b) => a.data.featuredOrder - b.data.featuredOrder).map((entry) => entry.data);
---

<section class="section section--light section--sand commercial-work">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Selected Commercial Work</p>
      <h2>A Closer Look</h2>
    </div>

    <div class="commercial-work__grid">
      {
        items.map((item) => (
          <figure class="commercial-work__tile">
            <Image
              src={item.image}
              alt={item.imageAlt}
              widths={[400, 700, 1000]}
              width={1000}
              sizes="(min-width: 55em) 33vw, (min-width: 40em) 50vw, 100vw"
              style={`object-position: ${item.objectPosition};`}
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .commercial-work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3px;
  }

  .commercial-work__tile {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-charcoal-soft);
  }

  .commercial-work__tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-editorial);
  }

  .commercial-work__tile:hover :global(img) {
    transform: scale(1.035);
  }

  @media (min-width: 40em) {
    .commercial-work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 55em) {
    .commercial-work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
