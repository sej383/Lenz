---
import { siteConfig } from "../../lib/site-config";
---

<section class="section section--light positioning-intro">
  <div class="container">
    <p class="eyebrow">Who We Work With</p>
    <p class="positioning-intro__statement">
      LENZ works with businesses, developers, organizations, property owners, contractors, and
      brands across {siteConfig.baseLocation} and {siteConfig.serviceArea}.
    </p>
  </div>
</section>

<style>
  .positioning-intro__statement {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.35;
    max-width: 46rem;
    margin-top: 0.5em;
    color: var(--color-charcoal);
  }
</style>
