---
import { Image } from "astro:assets";
import commercialPhoto from "../assets/photos/svc-commercial-gretna.jpg";
import brandingPhoto from "../assets/photos/svc-branding-coffee.jpg";
import aerialPhoto from "../assets/photos/hero-aerial.jpg";
import realEstatePhoto from "../assets/photos/svc-realestate-elkhorn.jpg";
import { siteConfig } from "../lib/site-config";
import BrandWordmark from "./BrandWordmark.astro";

const services = [
  {
    key: "commercial",
    label: "Commercial",
    href: "/services/commercial/",
    description:
      "Leasing offices, retail centers, industrial sites, and multifamily communities — photographed and flown to show a property at its most leasable.",
    image: commercialPhoto,
    alt: "Aerial view of the Gretna Rural Fire Department building",
    cta: { label: "Start a Project", href: "/contact/", external: false },
  },
  {
    key: "branding",
    label: "Branding",
    href: "/services/branding/",
    description:
      "Product photography, headshots, and brand imagery built for your website, deck, or ad campaign.",
    image: brandingPhoto,
    alt: "Close-up product photography of a burlap coffee sack",
    cta: { label: "Start a Project", href: "/contact/", external: false },
  },
  {
    key: "aerial",
    label: "Aerial",
    href: "/services/aerial/",
    description:
      "FAA Part 107 licensed drone coverage for real estate, construction progress, land, and events.",
    image: aerialPhoto,
    alt: "Straight-down aerial view of a large home with a backyard pool",
    cta: { label: "Start a Project", href: "/contact/", external: false },
  },
  {
    key: "real-estate",
    label: "Real Estate",
    href: "/services/real-estate/",
    description: "Listing photography ordered and delivered through a fast, professional booking system.",
    image: realEstatePhoto,
    alt: "Stone and metal-roofed home exterior on a sunny day",
    cta: { label: "Book Real Estate", href: siteConfig.bookRealEstateUrl, external: true },
  },
];
---

<section class="section section--light services" id="services">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal="eyebrow">What LENZ Does</p>
      <h2 data-reveal="heading">Four Ways to Put <BrandWordmark /> to Work</h2>
      <p data-reveal="body">
        Every project gets the same editorial eye, whether it's a single listing or a multi-site
        commercial portfolio.
      </p>
    </div>

    <div class="services__grid">
      {
        services.map((service) => (
          <article class:list={["service-tile", `service-tile--${service.key}`]}>
            <a class="service-tile__media" href={service.href} aria-hidden="true" tabindex="-1">
              <Image
                src={service.image}
                alt=""
                widths={[400, 700, 1000, 1300]}
                width={1300}
                sizes="(min-width: 62.5em) 45vw, 100vw"
              />
            </a>
            <div class="service-tile__blur" aria-hidden="true"></div>
            <div class="service-tile__scrim" aria-hidden="true"></div>
            <div class="service-tile__body">
              <span class="eyebrow">{service.label}</span>
              <h3>
                <a href={service.href}>{service.label}</a>
              </h3>
              <p>{service.description}</p>
              {service.cta.external ? (
                <a class="btn btn-secondary service-tile__cta" href={service.cta.href} target="_blank" rel="noopener noreferrer">
                  {service.cta.label}
                  <span class="visually-hidden">(opens the HDPhotoHub booking site in a new tab)</span>
                </a>
              ) : (
                <a class="btn btn-secondary service-tile__cta" href={service.cta.href}>
                  {service.cta.label}
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
  }

  .service-tile {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--color-charcoal);
    min-height: 22rem;
    border: 1px solid rgba(224, 176, 104, 0.16);
    box-shadow: 0 16px 32px -20px rgba(21, 17, 13, 0.5);
  }

  .service-tile__media {
    position: absolute;
    inset: 0;
  }

  .service-tile__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-editorial);
  }

  .service-tile:hover .service-tile__media :global(img) {
    transform: scale(1.035);
  }

  /* Full-tile scrim, not just a band behind the copy block — a hard-edged
     box directly under the text was the previous approach (a flat gradient
     confined to .service-tile__body's own bounded height), which left a
     visible seam where the box began and no darkening at all in the photo
     just above it. This sits between the photo and the content instead:
     an ellipse anchored at the bottom-left corner, sized well past the
     tile's own bounds so it reads as the photo itself falling into shadow
     rather than a caption plate. Strongest immediately behind the text,
     fading smoothly outward with no hard edge in any direction. Warm
     brown-black (matches --color-dark-4/5 from the leather system) rather
     than neutral black, consistent with the rest of the site's dark tone.
     pointer-events: none so it never blocks the decorative media link or
     the hover-triggered image scale beneath it. */
  /* Softens the photo's own detail directly behind the text (masked to the
     same footprint as the scrim below) rather than relying on darkening
     opacity alone. Needed for busy/high-contrast source photos — printed
     text on the Branding coffee sack, roofline detail on Aerial — where
     even strong darkening still let a pattern show through; a touch of
     blur removes the competing detail instead of just dimming it, which
     also reads more like a natural falloff of focus/shadow than a filter
     slapped on top. Masked (not just faded via its own opacity) so the
     blur radius itself doesn't visually smear past the darkened area. */
  .service-tile__blur {
    position: absolute;
    inset: 0;
    pointer-events: none;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    mask-image: radial-gradient(140% 120% at 0% 100%, black 0%, black 42%, transparent 78%);
    -webkit-mask-image: radial-gradient(140% 120% at 0% 100%, black 0%, black 42%, transparent 78%);
  }

  .service-tile__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Two layers: the radial ellipse carries the real weight directly
       behind the text (paired with the blur above, so it no longer needs
       to be pushed to near-opaque to do the job on its own). A second,
       much gentler full-width wash underneath takes the edge off bright
       spots outside the ellipse's reach (e.g. Real Estate's sunlit
       sidewalk/landscaping) without darkening the top of any tile, where
       the photo should stay bright. */
    background: radial-gradient(
        150% 130% at 0% 100%,
        rgba(10, 7, 4, 0.96) 0%,
        rgba(10, 7, 4, 0.9) 32%,
        rgba(10, 7, 4, 0.68) 52%,
        rgba(10, 7, 4, 0.32) 70%,
        rgba(10, 7, 4, 0) 88%
      ),
      linear-gradient(to top, rgba(10, 7, 4, 0.3) 0%, rgba(10, 7, 4, 0) 50%);
  }

  .service-tile__body {
    position: relative;
    margin-top: auto;
    padding: var(--space-sm);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5em;
    color: var(--color-offwhite);
  }

  .service-tile__body .eyebrow {
    color: var(--color-gold-soft);
    text-shadow: 0 1px 4px rgba(6, 4, 3, 0.7);
  }

  .service-tile__body h3 {
    font-size: var(--step-2);
    font-weight: 500;
    text-shadow: 0 1px 6px rgba(6, 4, 3, 0.55);
  }

  .service-tile__body h3 a {
    color: inherit;
  }

  .service-tile__body h3 a:hover,
  .service-tile__body h3 a:focus-visible {
    color: var(--color-gold-soft);
  }

  .service-tile__body p {
    max-width: 26rem;
    color: var(--color-offwhite);
    opacity: 0.9;
    font-size: var(--step--1);
    text-shadow: 0 1px 4px rgba(6, 4, 3, 0.75);
  }

  .service-tile__cta {
    margin-top: 0.4em;
    border-color: var(--color-offwhite);
    color: var(--color-offwhite);
    padding: 0.7em 1.4em;
    font-size: 0.72rem;
  }

  .service-tile__cta:hover,
  .service-tile__cta:focus-visible {
    background: var(--color-offwhite);
    color: var(--color-charcoal);
  }

  @media (min-width: 62.5em) {
    .services__grid {
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: 24rem;
      gap: 2px;
    }

    .service-tile--commercial {
      grid-column: span 7;
    }

    .service-tile--branding {
      grid-column: span 5;
    }

    .service-tile--aerial {
      grid-column: span 7;
    }

    .service-tile--real-estate {
      grid-column: span 5;
    }
  }
</style>
