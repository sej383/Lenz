---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import BrandWordmark from "./BrandWordmark.astro";

// No portrait of Sarah exists in the project yet. Once one is available,
// import it above and pass it in from the page, e.g.:
//   import sarahPortrait from "../assets/photos/sarah-portrait.jpg";
//   <AboutIntro portrait={sarahPortrait} />
// That alone restores the two-column portrait layout below — no redesign
// needed. Until then this renders as a clean text-only section.
interface Props {
  portrait?: ImageMetadata;
  portraitAlt?: string;
}

const { portrait, portraitAlt = "Portrait of Sarah, LENZ founder and photographer" } = Astro.props;
---

<section class="section section--dark surface-leather about-intro">
  <div class:list={["container", "about-intro__inner", { "about-intro__inner--with-portrait": !!portrait }]}>
    {
      portrait && (
        <div class="about-intro__portrait">
          <Image src={portrait} alt={portraitAlt} width={640} />
        </div>
      )
    }

    <div class="about-intro__body" data-reveal="section">
      <p class="eyebrow">About LENZ</p>
      <h2>Behind Every <BrandWordmark background="dark" /> Shoot</h2>
      <p>
        LENZ is Sarah's studio — hands-on from the first call to final delivery. Two decades of
        photography experience and an FAA Part 107 drone license mean every project, whether a
        single listing or a multi-building commercial portfolio, gets the same level of
        attention and technical precision.
      </p>
      <a class="btn btn-secondary btn-on-dark" href="/about/">More About LENZ</a>
    </div>
  </div>
</section>

<style>
  .about-intro__inner {
    display: flex;
    justify-content: flex-start;
  }

  .about-intro__portrait {
    aspect-ratio: 3 / 4;
    width: min(100%, 22rem);
    overflow: hidden;
  }

  .about-intro__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-intro__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    max-width: 34rem;
  }

  .about-intro__body p:not(.eyebrow) {
    color: var(--color-muted-on-dark);
  }

  .about-intro__body .btn {
    margin-top: var(--space-2xs);
  }

  /* Once a portrait prop is passed in, switch to a two-column layout with
     the photo alongside the copy — see the note in the frontmatter above. */
  .about-intro__inner--with-portrait {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    justify-content: normal;
  }

  @media (min-width: 50em) {
    .about-intro__inner--with-portrait {
      grid-template-columns: 22rem 1fr;
    }
  }
</style>
