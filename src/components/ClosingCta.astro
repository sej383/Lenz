---
import { siteConfig } from "../lib/site-config";
---

<section class="section section--dark surface-leather surface-drift closing-cta">
  <div class="container">
    <div class="section-head closing-cta__head">
      <p class="eyebrow" data-reveal="eyebrow">Get Started</p>
      <h2 data-reveal="heading">Start the Conversation, or Book the Shoot</h2>
    </div>

    <div class="closing-cta__paths" data-reveal="body">
      <div class="closing-cta__path">
        <span class="eyebrow">Marketing &amp; Visual Media</span>
        <p>Tell us about your business and what you need — we'll follow up to plan the right next step.</p>
        <a class="btn btn-primary" href="/contact/">Let's Talk About Your Business</a>
      </div>

      <div class="closing-cta__divider" aria-hidden="true"></div>

      <div class="closing-cta__path">
        <span class="eyebrow">Real Estate</span>
        <p>Book real estate photography directly — select your services and schedule online in just a few clicks.</p>
        <a class="btn btn-secondary btn-on-dark" href={siteConfig.bookRealEstateUrl} target="_blank" rel="noopener noreferrer">
          Book Real Estate
          <span class="visually-hidden">(opens the online booking site in a new tab)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .closing-cta__head {
    margin-bottom: var(--space-md);
  }

  .closing-cta__paths {
    display: grid;
    gap: var(--space-md);
  }

  .closing-cta__path {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6em;
  }

  .closing-cta__path p {
    color: var(--color-muted-on-dark);
    max-width: 26rem;
  }

  .closing-cta__divider {
    height: 1px;
    background: var(--color-hairline);
  }

  @media (min-width: 50em) {
    .closing-cta__paths {
      grid-template-columns: 1fr auto 1fr;
      align-items: start;
    }

    .closing-cta__divider {
      width: 1px;
      height: 100%;
      align-self: stretch;
    }
  }
</style>
