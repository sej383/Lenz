---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const entries = await getCollection("work", ({ data }) => data.featuredOnHome);
const items = entries.sort((a, b) => a.data.featuredOrder - b.data.featuredOrder).map((entry) => entry.data);
---

<section class="section section--dark surface-leather selected-work" id="work">
  <div class="container">
    <div class="section-head" data-reveal="section">
      <p class="eyebrow">Portfolio</p>
      <h2>A Glimpse of the Work</h2>
      <p>A little bit of everything — from businesses and brands to properties and views from above.</p>
    </div>

    <div class="work-grid">
      {
        items.map((item) => (
          <figure class="work-tile">
            <Image
              src={item.image}
              alt={item.imageAlt}
              widths={[500, 800, 1100]}
              width={1100}
              sizes="(min-width: 40em) 50vw, 100vw"
              style={`object-position: ${item.objectPosition};`}
            />
            <figcaption><span class="tag">{item.category}</span></figcaption>
          </figure>
        ))
      }
    </div>

    <div class="section-foot">
      <a class="btn btn-secondary btn-on-dark" href="/work/">View All Work</a>
    </div>
  </div>
</section>

<style>
  /* Scoped, not a change to the shared .section/.section-foot rules — the
     dark space around "View All Work" read slightly tall; trimmed the
     section's own bottom padding and the gap above the button by roughly
     12%, here only. */
  .selected-work {
    padding-bottom: calc(var(--space-xl) * 0.87);
  }

  .selected-work .section-foot {
    margin-top: calc(var(--space-lg) * 0.85);
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3px;
  }

  .work-tile {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--color-charcoal-soft);
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(224, 176, 104, 0.14);
  }

  .work-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-editorial);
  }

  .work-tile:hover :global(img) {
    transform: scale(1.035);
  }

  .work-tile figcaption {
    position: absolute;
    left: var(--space-2xs);
    bottom: var(--space-2xs);
  }

  .work-tile .tag {
    display: inline-block;
    padding: 0.35em 0.7em;
    background: rgba(21, 17, 13, 0.55);
    backdrop-filter: blur(2px);
    color: var(--color-gold-soft);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (min-width: 40em) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3px;
    }
  }
</style>
