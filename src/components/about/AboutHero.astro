---
// Portrait-ready, same mechanism as the homepage's AboutIntro: no photo of
// Sarah exists in the project yet, so this renders text-only until one is
// supplied. Passing a `portrait` prop later switches to a two-column
// layout automatically — no rebuild needed. Never substitute a stock photo
// here in the meantime.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import BrandWordmark from "../BrandWordmark.astro";

interface Props {
  portrait?: ImageMetadata;
  portraitAlt?: string;
}

const { portrait, portraitAlt = "Portrait of Sarah Lenz, LENZ founder and photographer" } = Astro.props;
---

<section class="about-hero surface-leather">
  <div class:list={["container", "about-hero__inner", { "about-hero__inner--with-portrait": !!portrait }]}>
    {
      portrait && (
        <div class="about-hero__portrait">
          <Image src={portrait} alt={portraitAlt} width={800} />
        </div>
      )
    }

    <div class="about-hero__body">
      <p class="eyebrow">About LENZ</p>
      <h1>The Eye Behind <BrandWordmark background="dark" /></h1>
      <p class="about-hero__lead">
        Sarah Lenz has spent more than twenty years behind a camera, and she personally owns and
        runs every part of LENZ. This isn't a large, anonymous media company — it's one
        photographer, hands-on from the first phone call to final delivery.
      </p>
    </div>
  </div>
</section>

<style>
  .about-hero {
    color: var(--color-offwhite);
    padding-block: var(--space-xl);
  }

  .about-hero__inner {
    display: flex;
    justify-content: flex-start;
  }

  .about-hero__portrait {
    aspect-ratio: 3 / 4;
    width: min(100%, 26rem);
    overflow: hidden;
    border: 1px solid rgba(224, 176, 104, 0.16);
  }

  .about-hero__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-hero__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    max-width: 38rem;
  }

  .about-hero__body h1 {
    font-size: var(--step-4);
    font-weight: 500;
    color: var(--color-offwhite);
    margin-top: 0.2em;
  }

  .about-hero__lead {
    font-size: var(--step-1);
    color: var(--color-muted-on-dark);
  }

  .about-hero__inner--with-portrait {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    justify-content: normal;
  }

  @media (min-width: 50em) {
    .about-hero__inner--with-portrait {
      grid-template-columns: 26rem 1fr;
    }
  }
</style>
