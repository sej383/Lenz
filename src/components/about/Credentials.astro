---
// Same restrained inline dot-divided list treatment used for Branding's
// "usable across channels" row — reads as quiet editorial text, not a
// badge grid, which is what a "restrained" credibility section calls for.
import { siteConfig } from "../../lib/site-config";

const credentials = [
  "20+ Years of Photography Experience",
  "FAA Part 107 Licensed & Insured",
  "Ground + Aerial Capability",
  "Based in Western Iowa",
  `Serving ${siteConfig.serviceArea}`,
];
---

<section class="section section--light section--sand credentials">
  <div class="container">
    <p class="eyebrow">Credentials &amp; Service Region</p>
    <ul class="credentials__list">
      {credentials.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .credentials__list {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.5em;
    margin-top: var(--space-sm);
    list-style: none;
    padding: 0;
    max-width: 52rem;
  }

  .credentials__list li {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-charcoal);
  }

  .credentials__list li:not(:last-child)::after {
    content: "·";
    display: inline-block;
    margin-inline: 0.75em;
    color: var(--color-gold);
  }
</style>
