<section class="section section--light contact-intro">
  <div class="container">
    <p class="eyebrow">Contact</p>
    <h1 class="contact-intro__heading">Get In Touch</h1>
    <p class="contact-intro__copy">
      Real estate listings book directly online. For commercial, branding, aerial, or general
      inquiries, send a few details below and we'll follow up.
    </p>
  </div>
</section>

<style>
  .contact-intro__heading {
    font-size: var(--step-3);
    font-weight: 500;
    margin-top: 0.35em;
    color: var(--color-charcoal);
  }

  .contact-intro__copy {
    margin-top: var(--space-2xs);
    font-size: var(--step-0);
    color: var(--color-muted);
    max-width: 36rem;
  }

  @media (min-width: 62.5em) {
    .contact-intro {
      padding-block: calc(var(--space-xl) * 0.82);
    }
  }
</style>
