---
import { siteConfig } from "../../lib/site-config";

const telHref = siteConfig.contact.phone ? `tel:${siteConfig.contact.phone.replace(/[^\d+]/g, "")}` : null;
---

<div class="contact-info">
  <h2 class="contact-info__heading">Contact Information</h2>
  <ul class="contact-info__list">
    {
      siteConfig.contact.email && (
        <li>
          <span class="contact-info__label">Email</span>
          <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
        </li>
      )
    }
    {
      siteConfig.contact.phone && telHref && (
        <li>
          <span class="contact-info__label">Phone</span>
          <a href={telHref}>{siteConfig.contact.phone}</a>
        </li>
      )
    }
    <li>
      <span class="contact-info__label">Service Area</span>
      <span>{siteConfig.baseLocation} · Serving {siteConfig.serviceArea}</span>
      <span class="contact-info__note">Travel available for projects outside this area.</span>
    </li>
  </ul>
</div>

<style>
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .contact-info__heading {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-charcoal);
  }

  .contact-info__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .contact-info__list li {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }

  .contact-info__label {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .contact-info__list a,
  .contact-info__list span:not(.contact-info__label) {
    color: var(--color-charcoal);
    font-size: var(--step-0);
  }

  .contact-info__list a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .contact-info__note {
    color: var(--color-muted);
    font-size: var(--step--1);
  }
</style>
